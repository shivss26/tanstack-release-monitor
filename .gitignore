.venv/
.env
__pycache__/
*.pyc
.worktrees/

# Local agent and retrieval state. These must never enter the public repository.
.agents/
.codex/
.firecrawl/

# The old pipeline's generated payloads can include full upstream text or delivery
# metadata. Keep the historical tracked examples, but never add new ones.
/raw/**
!/raw/.gitkeep
/yanks/**
!/yanks/.gitkeep
/prefetch/
/summaries/
/transcripts/
/digest/
/sent/
